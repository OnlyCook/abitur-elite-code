<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AbiturEliteCode.SettingsWindow"
        Title="Einstellungen"
        Width="600" Height="450"
        WindowStartupLocation="CenterOwner"
        Background="#252526"
        SystemDecorations="BorderOnly">

	<Window.Styles>
	    <!-- settings badge blinking -->
		<Style Selector="Border.maintenance-blink">
			<Style.Animations>
				<Animation Duration="0:0:3" IterationCount="INFINITE">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="1.0" />
					</KeyFrame>
					<KeyFrame Cue="66%">
						<Setter Property="Opacity" Value="1.0" />
					</KeyFrame>
					<KeyFrame Cue="83%">
						<Setter Property="Opacity" Value="0.3" />
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1.0" />
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
	</Window.Styles>
	
    <Border CornerRadius="8"
            Background="#252526"
            BorderBrush="Transparent"
            BorderThickness="0">

        <Grid ColumnDefinitions="160,*" RowDefinitions="*,Auto">

            <!-- left nav bar -->
			<Border Grid.Column="0" Grid.RowSpan="2"
                    Background="#2D2D30"
                    CornerRadius="0 10 10 0">
				<Grid RowDefinitions="*,Auto">

					<StackPanel Grid.Row="0">
						<TextBlock Text="Einstellungen"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#32A852"
                               Margin="15" />

                        <Button x:Name="BtnCatEditor"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="15" Margin="2"
                                CornerRadius="4"
                                Background="Transparent"
                                Foreground="White"
                                Content="Editor" />

                        <Button x:Name="BtnCatDisplay"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="15" Margin="2"
                                CornerRadius="4"
                                Background="Transparent"
                                Foreground="White"
                                Content="Darstellung" />

                        <Button x:Name="BtnCatData"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="15" Margin="2"
                                CornerRadius="4"
                                Background="Transparent"
                                Foreground="White"
                                Content="Daten" />

                        <!-- updates category (w/ notificator) -->
                        <Button x:Name="BtnCatUpdates"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="15" Margin="2"
                                CornerRadius="4"
                                Background="Transparent"
                                Foreground="White">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Updates"
                                           VerticalAlignment="Center" />
                                <Border x:Name="UpdatesBadge"
                                        Grid.Column="1"
                                        Background="#B43232"
                                        Width="8" Height="8"
                                        CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Margin="5,0,0,0"
                                        IsVisible="False" />
                            </Grid>
                        </Button>

                        <Button x:Name="BtnCatMisc"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="15" Margin="2"
                                CornerRadius="4"
                                Background="Transparent"
                                Foreground="White"
                                Content="Sonstiges" />
                    </StackPanel>

                    <!-- save/reset -->
					<StackPanel Grid.Row="1"
								Orientation="Horizontal"
								HorizontalAlignment="Center"
								Spacing="10"
								Margin="10,15">
						<Button x:Name="BtnReset"
                                Width="50" Height="40"
                                Background="#B43232"
                                CornerRadius="5" />
						<Button x:Name="BtnSave"
                                Width="60" Height="40"
                                Background="#32A852"
                                CornerRadius="5"
                                IsEnabled="False"
                                Opacity="0.5" />
					</StackPanel>
				</Grid>
			</Border>

            <!-- right panel (filled programmatically) -->
            <Border x:Name="RightPanel"
                    Grid.Column="1"
                    Padding="20"
                    Background="#252526" />

            <!-- close button -->
            <Button x:Name="BtnClose"
                    Grid.Column="1" Grid.Row="1"
                    Content="Schließen"
                    Width="100"
                    HorizontalContentAlignment="Center"
                    HorizontalAlignment="Right"
                    Padding="15,8"
                    CornerRadius="4"
                    Margin="20,-5,20,15"
                    Background="#3C3C3C"
                    Foreground="White" />
        </Grid>
    </Border>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Avalonia.Svg.Skia"
        xmlns:local="clr-namespace:AbiturEliteCode;assembly=AbiturEliteCode"
        mc:Ignorable="d" d:DesignWidth="1250" d:DesignHeight="850"
        x:Class="AbiturEliteCode.MainWindow"
        Title="Abitur Elite Code"
        Width="1250" Height="850"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static local:Scheme.BrushBgPanel19}"
        RequestedThemeVariant="Dark">

	<Window.Styles>
		<!-- easier text selection -->
		<Style Selector="SelectableTextBlock">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>

		<!-- tabs -->
		<Style Selector="TabItem">
			<Setter Property="FontSize" Value="15" />
			<Setter Property="Foreground" Value="{x:Static local:Scheme.BrushTextNormal7}" />
			<Setter Property="Margin" Value="0,2,2,2" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Template">
				<ControlTemplate>
					<Border Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="16,13">
						<ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Header}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontWeight="{TemplateBinding FontWeight}" />
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>

		<Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="{x:Static local:Scheme.BrushBgPanel13}" />
		</Style>
		<Style Selector="TabItem:pointerover">
			<Setter Property="Foreground" Value="{x:Static local:Scheme.BrushTextNormal7}" />
		</Style>

		<Style Selector="TabItem:selected">
			<Setter Property="Foreground" Value="{x:Static local:Scheme.BrushTextTitle}" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="0,2,2,2" />
		</Style>

		<Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="{x:Static local:Scheme.BrushBgPanel}" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="16,13" />
		</Style>

		<Style Selector="TabItem.latch:selected">
			<Setter Property="Margin" Value="0,2,2,-13" />
		</Style>

		<Style Selector="TabItem.latch:selected /template/ Border#PART_LayoutRoot">
			<Setter Property="CornerRadius" Value="8,8,0,0" />
			<Setter Property="Padding" Value="16,13,16,26" />
		</Style>

		<Style Selector="TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
			<Setter Property="Background" Value="{x:Static local:Scheme.BrushBgPanel}" />
		</Style>
		<Style Selector="TabItem:selected:pointerover">
			<Setter Property="Foreground" Value="{x:Static local:Scheme.BrushTextTitle}" />
		</Style>

		<!-- grid splitters -->
		<Style Selector="GridSplitter.dock-vertical">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Width" Value="8" />
			<Setter Property="Cursor" Value="SizeWestEast" />
			<Setter Property="Template">
				<ControlTemplate>
					<Grid Background="Transparent">
						<Border Name="HoverLine" Background="{x:Static local:Scheme.BrushTextTitle}" Width="2" HorizontalAlignment="Center" Opacity="0" />
						<Border Name="Handle" Background="{x:Static local:Scheme.BrushTextNormal2}" Width="2" Height="30" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Grid>
				</ControlTemplate>
			</Setter>
		</Style>

		<Style Selector="GridSplitter.dock-horizontal">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Height" Value="8" />
			<Setter Property="Cursor" Value="SizeNorthSouth" />
			<Setter Property="Template">
				<ControlTemplate>
					<Grid Background="Transparent">
						<Border Name="HoverLine" Background="{x:Static local:Scheme.BrushTextTitle}" Height="2" VerticalAlignment="Center" Opacity="0" />
						<Border Name="Handle" Background="{x:Static local:Scheme.BrushTextNormal2}" Height="2" Width="30" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Grid>
				</ControlTemplate>
			</Setter>
		</Style>

		<Style Selector="GridSplitter.dock-vertical /template/ Border#HoverLine, GridSplitter.dock-horizontal /template/ Border#HoverLine">
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="GridSplitter.dock-vertical.hover-active /template/ Border#HoverLine, GridSplitter.dock-horizontal.hover-active /template/ Border#HoverLine">
			<Setter Property="Opacity" Value="1" />
		</Style>

		<Style Selector="GridSplitter.dock-vertical /template/ Border#Handle, GridSplitter.dock-horizontal /template/ Border#Handle">
			<Setter Property="Transitions">
				<Transitions>
					<DoubleTransition Property="Opacity" Duration="0:0:0.15" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="GridSplitter.dock-vertical.hover-active /template/ Border#Handle, GridSplitter.dock-horizontal.hover-active /template/ Border#Handle">
			<Setter Property="Opacity" Value="0" />
		</Style>

		<Style Selector="GridSplitter.dock-vertical.dragging /template/ Border#HoverLine, GridSplitter.dock-horizontal.dragging /template/ Border#HoverLine">
			<Setter Property="Transitions">
				<Transitions />
			</Setter>
			<Setter Property="Opacity" Value="1" />
		</Style>
		<Style Selector="GridSplitter.dock-vertical.dragging /template/ Border#Handle, GridSplitter.dock-horizontal.dragging /template/ Border#Handle">
			<Setter Property="Transitions">
				<Transitions />
			</Setter>
			<Setter Property="Opacity" Value="0" />
		</Style>

		<!-- settings badge blinking -->
		<Style Selector="Border.maintenance-blink">
			<Style.Animations>
				<Animation Duration="0:0:3" IterationCount="INFINITE">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="1.0" />
					</KeyFrame>
					<KeyFrame Cue="66%">
						<Setter Property="Opacity" Value="1.0" />
					</KeyFrame>
					<KeyFrame Cue="83%">
						<Setter Property="Opacity" Value="0.3" />
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="1.0" />
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>
		
		<!-- editor border -->
		<Style Selector="Border.editor-focus-border">
			<Setter Property="BorderBrush" Value="{x:Static local:Scheme.BrushBgPanel5}" />
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Border.editor-focus-border:focus-within">
			<Setter Property="BorderBrush" Value="{x:Static local:Scheme.BrushTextHighlight2}" />
		</Style>
	</Window.Styles>

	<LayoutTransformControl Name="RootScaleTransform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
		<Grid>
			<Grid Name="RootGrid" RowDefinitions="60,*">

				<Border Grid.Row="0" Background="{x:Static local:Scheme.BrushBgPanel}" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" BorderThickness="0,0,0,1">
					<Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto, Auto, Auto">
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0">
							<TextBlock Text="ABITUR" Foreground="{x:Static local:Scheme.BrushTextNormal}" FontWeight="Bold" FontSize="18" />
							<TextBlock Text=" ELITE CODE" Foreground="{x:Static local:Scheme.BrushTextTitle}" FontWeight="Bold" FontSize="18" />
						</StackPanel>

						<Button Grid.Column="1" Name="BtnModeSwitch" Content="MODUS: C#"
								Background="{x:Static local:Scheme.BrushBgPanel}" Foreground="{x:Static local:Scheme.BrushTextHighlight}"
								BorderBrush="{x:Static local:Scheme.BrushTextHighlight}" BorderThickness="1"
								CornerRadius="4" Padding="15,8"
								VerticalAlignment="Center" Margin="0,0,20,0"
								FontWeight="Bold"
								Click="BtnModeSwitch_Click" />

						<Button Grid.Column="2" Name="BtnLevelSelect" Content="LEVEL WÄHLEN"
								Background="{x:Static local:Scheme.BrushBgPanel13}" Foreground="White"
								CornerRadius="4" Padding="15,8"
								VerticalAlignment="Center" Margin="0,0,5,0"
								Click="BtnLevelSelect_Click" />

						<Button Grid.Column="3" Name="BtnCustomLevelReturn" IsVisible="false"
								Background="{x:Static local:Scheme.BrushBgPanel13}" ToolTip.Tip="Eigenes Level gespeichert verlassen"
								CornerRadius="4" VerticalAlignment="Center" Margin="0,0,20,0"
								Click="BtnCustomLevelReturn_Click">
							<svg:Svg Path="/assets/icons/ic_return.svg" Width="20" Height="20" />
						</Button>
						
						<Button Grid.Column="4" Name="BtnPrevLevel" Content="←"
								Background="{x:Static local:Scheme.BrushBgPanel5}" Foreground="White"
								CornerRadius="4" Padding="15,8" FontWeight="Bold"
								VerticalAlignment="Center" Margin="0,0,10,0"
								Click="BtnPrevLevel_Click" />

						<Button Grid.Column="5" Name="BtnNextLevel" Content="→"
								Background="RoyalBlue" Foreground="White"
								CornerRadius="4" Padding="15,8" FontWeight="Bold"
								VerticalAlignment="Center" Margin="0,0,20,0"
								Click="BtnNextLevel_Click" />

						<Button Grid.Column="6" Name="BtnExitDesigner" Content="DESIGNER VERLASSEN"
								Background="{x:Static local:Scheme.BrushDiffHard}" Foreground="White" IsVisible="False"
								CornerRadius="4" Padding="15,8" FontWeight="Bold"
								VerticalAlignment="Center" Margin="0,0,20,0"
								Click="BtnExitDesigner_Click" />
					</Grid>
				</Border>

				<Grid Grid.Row="1" ColumnDefinitions="*, 8, *">

					<Panel Grid.Column="0" Name="LeftPanelContainer" Margin="10,2,0,10">
						<TabControl Name="MainTabs" Padding="0">
							<TabControl.Styles>
								<Style Selector="TabItem">
									<Setter Property="FontSize" Value="15" />
									<Setter Property="Foreground" Value="{x:Static local:Scheme.BrushTextNormal7}" />
									<Setter Property="Margin" Value="0,2,2,2" />
									<Setter Property="Background" Value="Transparent" />
									<Setter Property="VerticalAlignment" Value="Center" />
									<Setter Property="Template">
										<ControlTemplate>
											<Border Name="PART_LayoutRoot"
													Background="{TemplateBinding Background}"
													CornerRadius="6"
													Padding="16,13">
												<ContentPresenter Name="PART_ContentPresenter"
																  Content="{TemplateBinding Header}"
																  HorizontalAlignment="Center"
																  VerticalAlignment="Center"
																  TextBlock.Foreground="{TemplateBinding Foreground}"
																  TextBlock.FontWeight="{TemplateBinding FontWeight}" />
											</Border>
										</ControlTemplate>
									</Setter>
								</Style>

								<Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
									<Setter Property="Background" Value="{x:Static local:Scheme.BrushBgPanel13}" />
								</Style>
								<Style Selector="TabItem:pointerover">
									<Setter Property="Foreground" Value="{x:Static local:Scheme.BrushTextNormal7}" />
								</Style>

								<Style Selector="TabItem:selected">
									<Setter Property="Foreground" Value="{x:Static local:Scheme.BrushTextTitle}" />
									<Setter Property="FontWeight" Value="SemiBold" />
									<Setter Property="Margin" Value="0,2,2,2" />
								</Style>

								<Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
									<Setter Property="Background" Value="{x:Static local:Scheme.BrushBgPanel}" />
									<Setter Property="CornerRadius" Value="8" />
									<Setter Property="Padding" Value="16,13" />
								</Style>

								<Style Selector="TabItem.latch:selected">
									<Setter Property="Margin" Value="0,2,2,-13" />
								</Style>

								<Style Selector="TabItem.latch:selected /template/ Border#PART_LayoutRoot">
									<Setter Property="CornerRadius" Value="8,8,0,0" />
									<Setter Property="Padding" Value="16,13,16,26" />
								</Style>

								<Style Selector="TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
									<Setter Property="Background" Value="{x:Static local:Scheme.BrushBgPanel}" />
								</Style>
								<Style Selector="TabItem:selected:pointerover">
									<Setter Property="Foreground" Value="{x:Static local:Scheme.BrushTextTitle}" />
								</Style>
							</TabControl.Styles>

							<TabItem Name="TabTask" Header="Aufgabe">
								<Border Background="{x:Static local:Scheme.BrushBgPanel}" CornerRadius="8" Margin="0" ClipToBounds="True">
									<Grid RowDefinitions="*, Auto">

										<ScrollViewer Grid.Row="0" Name="TaskScrollViewer" ScrollChanged="TaskScrollViewer_ScrollChanged">
											<StackPanel Margin="20">
												<StackPanel Name="PnlTask" Spacing="10" />
												<StackPanel Name="PnlTaskRelationalModel" Spacing="10" Margin="0,20,0,0" />

												<StackPanel Name="PnlCommentsSection" IsVisible="False" Margin="0,40,0,0">
													<Separator Background="{x:Static local:Scheme.BrushBgPanel5}" Margin="0,0,0,20" />
													<Grid ColumnDefinitions="*, Auto" Margin="0,0,0,15">
														<TextBlock Text="Kommentare" FontSize="18" FontWeight="Bold" Foreground="{x:Static local:Scheme.BrushTextHighlight}" VerticalAlignment="Center" />
														<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
															<TextBlock Text="Sortieren:" Foreground="Gray" VerticalAlignment="Center" />
															<ComboBox Name="CmbCommentSort" Background="{x:Static local:Scheme.BrushBgPanel3}" Foreground="White" SelectedIndex="0" SelectionChanged="CmbCommentSort_SelectionChanged">
																<ComboBoxItem Content="Beste" />
																<ComboBoxItem Content="Top" />
																<ComboBoxItem Content="Neuste" />
																<ComboBoxItem Content="Älteste" />
															</ComboBox>
															<Button Name="BtnCommunityDiscussionMenu" Background="Transparent" Padding="5" Cursor="Hand" IsVisible="False">
																<svg:Svg Path="/assets/icons/ic_menu.svg" Width="20" Height="20" VerticalAlignment="Center" />
															</Button>
														</StackPanel>
													</Grid>

													<Border Background="{x:Static local:Scheme.BrushBgPanel3}" CornerRadius="6" Padding="15" Margin="0,0,0,20" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" BorderThickness="1">
														<Grid RowDefinitions="Auto, *">

															<Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" Margin="0,0,0,10">
																<Button Grid.Column="0" Name="BtnTabEdit" Content="Editieren"
																		Background="{x:Static local:Scheme.BrushBgPanel}" Foreground="{x:Static local:Scheme.BrushTextTitle}" FontWeight="SemiBold"
																		CornerRadius="6" Padding="12,6" Margin="0,0,5,0"
																		Click="BtnTabComment_Click" />

																<Button Grid.Column="1" Name="BtnTabPreview" Content="Vorschau"
																		Background="Transparent" Foreground="{x:Static local:Scheme.BrushTextNormal7}"
																		CornerRadius="6" Padding="12,6"
																		Click="BtnTabComment_Click" />

																<Button Grid.Column="3" Name="BtnMarkdownToolbar" Background="Transparent" Padding="5" Cursor="Hand" ToolTip.Tip="Markdown Formatierung">
																	<svg:Svg Path="/assets/icons/ic_markdown.svg" Width="20" Height="20" VerticalAlignment="Center" />
																	<Button.Flyout>
																		<Flyout Placement="BottomEdgeAlignedRight">
																			<StackPanel Spacing="5" Width="160" Margin="-5,-5,-5,-5">
																				<Button Tag="Heading" Click="BtnInsertMarkdown_Click" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
																					<StackPanel Orientation="Horizontal" Spacing="8">
																						<svg:Svg Path="/assets/icons/ic_md_heading.svg" Width="16" Height="16" />
																						<TextBlock Text="Überschrift" VerticalAlignment="Center" />
																					</StackPanel>
																				</Button>
																				<Button Tag="Bold" Click="BtnInsertMarkdown_Click" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
																					<StackPanel Orientation="Horizontal" Spacing="8">
																						<svg:Svg Path="/assets/icons/ic_md_bold.svg" Width="16" Height="16" />
																						<TextBlock Text="Fett" VerticalAlignment="Center" />
																					</StackPanel>
																				</Button>
																				<Button Tag="Italic" Click="BtnInsertMarkdown_Click" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
																					<StackPanel Orientation="Horizontal" Spacing="8">
																						<svg:Svg Path="/assets/icons/ic_md_italic.svg" Width="16" Height="16" />
																						<TextBlock Text="Kursiv" VerticalAlignment="Center" />
																					</StackPanel>
																				</Button>
																				<Button Tag="InlineCode" Click="BtnInsertMarkdown_Click" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
																					<StackPanel Orientation="Horizontal" Spacing="8">
																						<svg:Svg Path="/assets/icons/ic_md_code.svg" Width="16" Height="16" />
																						<TextBlock Text="Inline-Code" VerticalAlignment="Center" />
																					</StackPanel>
																				</Button>
																				<Button Tag="CodeBlock" Click="BtnInsertMarkdown_Click" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
																					<StackPanel Orientation="Horizontal" Spacing="8">
																						<svg:Svg Path="/assets/icons/ic_md_codeblock.svg" Width="16" Height="16" />
																						<TextBlock Text="Code Block" VerticalAlignment="Center" />
																					</StackPanel>
																				</Button>
																				<Button Tag="List" Click="BtnInsertMarkdown_Click" Background="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand">
																					<StackPanel Orientation="Horizontal" Spacing="8">
																						<svg:Svg Path="/assets/icons/ic_md_list.svg" Width="16" Height="16" />
																						<TextBlock Text="Liste" VerticalAlignment="Center" />
																					</StackPanel>
																				</Button>
																			</StackPanel>
																		</Flyout>
																	</Button.Flyout>
																</Button>

																<ComboBox Grid.Column="4" Name="CmbCommentTag" Background="{x:Static local:Scheme.BrushTextNormal3}" Foreground="White" SelectedIndex="0" Margin="10,0,0,0">
																	<ComboBoxItem Content="–" />
																	<ComboBoxItem Content="Feedback" />
																	<ComboBoxItem Content="Frage" />
																	<ComboBoxItem Content="Tipp" />
																	<ComboBoxItem Content="Lösung" />
																</ComboBox>
															</Grid>

															<Grid Grid.Row="1" RowDefinitions="*, Auto">

																<TextBox Grid.Row="0" Name="TxtCommentInput" MinHeight="80" MaxHeight="200" AcceptsReturn="True" TextWrapping="Wrap" Background="{x:Static local:Scheme.BrushBgPanel7}" Foreground="White" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" Watermark="Schreibe einen Kommentar..." TextChanged="TxtCommentInput_TextChanged" />

																<Border Grid.Row="0" Name="PnlCommentPreview" MinHeight="80" MaxHeight="200" IsVisible="False" Background="{x:Static local:Scheme.BrushBgPanel7}" CornerRadius="4" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" BorderThickness="1" Padding="10">
																	<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
																		<StackPanel Name="PnlCommentPreviewContent" Spacing="5" />
																	</ScrollViewer>
																</Border>

																<Grid Grid.Row="1" ColumnDefinitions="*, Auto, Auto" Margin="0,10,0,0">
																	<TextBlock Name="TxtCommentCharCount" Text="0 / 5000" Foreground="Gray" FontSize="11" VerticalAlignment="Center" />
																	<TextBlock Grid.Column="1" Name="TxtCooldownMessage" Foreground="{x:Static local:Scheme.BrushStatusErrorText}" FontWeight="Bold" Margin="0,0,15,0" VerticalAlignment="Center" IsVisible="False" />
																	<Button Grid.Column="2" Name="BtnSendComment" Background="{x:Static local:Scheme.BrushBgPanel2}" CornerRadius="4" Cursor="Hand" Click="BtnSendComment_Click" IsEnabled="False" Opacity="0.5">
																		<svg:Svg Name="IconSendComment" Path="/assets/icons/ic_send_disabled.svg" Width="20" Height="20" />
																	</Button>
																</Grid>
															</Grid>

														</Grid>
													</Border>

													<StackPanel Name="PnlCommentsList" Spacing="15" />
													<TextBlock Name="TxtCommentsEmpty" Text="Noch keine Kommentare vorhanden. Sei der Erste! " Foreground="Gray" FontStyle="Italic" HorizontalAlignment="Center" IsVisible="False" Margin="0,10,0,0" />
													<TextBlock Name="TxtCommentsLocked" Text="Diese Diskussion ist derzeit gesperrt oder nicht verfügbar " Foreground="Gray" FontStyle="Italic" IsVisible="False" Margin="0,10,0,0" />
													<TextBlock Name="TxtCommentsLoading" Text="Lädt..." Foreground="Gray" HorizontalAlignment="Center" IsVisible="False" Margin="0,10,0,0" />
													<Button Name="BtnLoadMoreComments" Content="Weitere Kommentare laden..." Background="Transparent" Foreground="{x:Static local:Scheme.BrushTextHighlight}" HorizontalAlignment="Center" IsVisible="False" Margin="0,10,0,0" Click="BtnLoadMoreComments_Click" />
												</StackPanel>
											</StackPanel>
										</ScrollViewer>

										<Button Grid.Row="0" Name="BtnScrollTopComments"
												Width="40" Height="40" CornerRadius="20" Background="{x:Static local:Scheme.BrushBgPanel2}"
												HorizontalAlignment="Right" VerticalAlignment="Bottom"
												Margin="0,0,25,25" IsVisible="False"
												Click="BtnScrollTopComments_Click">
											<svg:Svg Name="IconScrollTop" Path="/assets/icons/ic_arrow_up.svg" Width="28" Height="28" />
										</Button>

										<Border Grid.Row="1" Name="PnlCommunityActions" Background="{x:Static local:Scheme.BrushBadgeDefault}" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" BorderThickness="0,1,0,0" IsVisible="False">
											<StackPanel>
												<TextBlock Name="TxtCommunityOutdatedStatus" Text="Du musst auf der neusten Version sein, um an Community-Features teilzunehmen " Foreground="{x:Static local:Scheme.BrushStatusErrorText}" Margin="15,8,0,0" IsVisible="False" FontStyle="Italic" HorizontalAlignment="Center" />
												<TextBlock Name="TxtCommunityMaintenanceStatus" Text="Wartungsarbeiten sind derzeit aktiv " Foreground="{x:Static local:Scheme.BrushStatusErrorText}" Margin="15,8,0,0" IsVisible="False" FontStyle="Italic" HorizontalAlignment="Center" />
												<TextBlock Name="TxtCommunityOfflineStatus" Text="Keine Internetverbindung " Foreground="{x:Static local:Scheme.BrushStatusErrorText}" Margin="15,8,0,0" IsVisible="False" FontStyle="Italic" HorizontalAlignment="Center" />
												<TextBlock Name="TxtCommunityNotFoundStatus" Text="Level-Diskussion nicht gefunden " Foreground="{x:Static local:Scheme.BrushStatusErrorText}" Margin="15,8,0,0" IsVisible="False" FontStyle="Italic" HorizontalAlignment="Center" />
												<TextBlock Name="TxtCommunityFullQueueStatus" Text="Du sendest zu viele Anfragen " Foreground="{x:Static local:Scheme.BrushStatusErrorText}" Margin="15,8,0,0" IsVisible="False" FontStyle="Italic" HorizontalAlignment="Center" />
												<Button Name="BtnCommunityLoggedOutStatus" Background="Transparent" Padding="0" Margin="15,8,0,0" IsVisible="False" HorizontalAlignment="Center" Cursor="Hand" Click="BtnCommunityLoggedOutStatus_Click">
													<TextBlock Text="Melde dich an, um an Community-Features teilzunehmen " Foreground="{x:Static local:Scheme.BrushTextHighlight}" FontStyle="Italic" TextDecorations="Underline" />
												</Button>
												<Grid ColumnDefinitions="Auto, Auto, *, Auto" Margin="15,10">
													<Button Grid.Column="0" Name="BtnLike" Background="Transparent" Margin="0,0,10,0" Click="BtnLike_Click">
														<StackPanel Orientation="Horizontal" Spacing="5">
															<svg:Svg Path="/assets/icons/ic_like.svg" Name="IconLike" Width="20" Height="20" />
															<TextBlock Name="TxtLikeCount" Text="0" VerticalAlignment="Center" Foreground="{x:Static local:Scheme.BrushTextNormal}" IsVisible="False" />
															<Border Name="SkeletonLike" Width="20" Height="14" CornerRadius="2" Background="{x:Static local:Scheme.BrushBgPanel2}" VerticalAlignment="Center" />
														</StackPanel>
													</Button>
													<Button Grid.Column="1" Name="BtnDislike" Background="Transparent" Margin="0,0,10,0" Click="BtnDislike_Click">
														<StackPanel Orientation="Horizontal" Spacing="5">
															<svg:Svg Path="/assets/icons/ic_dislike.svg" Name="IconDislike" Width="20" Height="20" />
															<TextBlock Name="TxtDislikeCount" Text="0" VerticalAlignment="Center" Foreground="{x:Static local:Scheme.BrushTextNormal}" IsVisible="False" />
															<Border Name="SkeletonDislike" Width="20" Height="14" CornerRadius="2" Background="{x:Static local:Scheme.BrushBgPanel2}" VerticalAlignment="Center" />
														</StackPanel>
													</Button>
													<Button Grid.Column="3" Name="BtnToggleComments" Background="Transparent" Click="BtnToggleComments_Click">
														<StackPanel Orientation="Horizontal" Spacing="5">
															<svg:Svg Name="IconToggleComments" Path="/assets/icons/ic_comment.svg" Width="20" Height="20" />
															<TextBlock Name="TxtCommentCount" Text="0" VerticalAlignment="Center" Foreground="{x:Static local:Scheme.BrushTextNormal}" IsVisible="False" />
															<Border Name="SkeletonComment" Width="20" Height="14" CornerRadius="2" Background="{x:Static local:Scheme.BrushBgPanel2}" VerticalAlignment="Center" />
														</StackPanel>
													</Button>
												</Grid>
											</StackPanel>
										</Border>

									</Grid>
								</Border>
							</TabItem>

							<TabItem Name="TabUml" Header="UML/Diagramme">
								<Border Background="{x:Static local:Scheme.BrushBgPanel}" CornerRadius="8" ClipToBounds="True" Margin="0">
									<Grid Name="UmlTabGrid" RowDefinitions="*, 8, Auto">
										<Panel Name="DiagramPanel" Grid.Row="0" Background="Transparent"
											   PointerWheelChanged="Diagram_PointerWheelChanged"
											   PointerPressed="Diagram_PointerPressed"
											   PointerMoved="Diagram_PointerMoved"
											   PointerReleased="Diagram_PointerReleased">

											<TextBlock Name="TxtNoDiagram"
													   Text="Kein Diagramm vorhanden.&#x0a;Siehe 'Materialien' für Details."
													   Foreground="{x:Static local:Scheme.BrushBgPanel8}" FontSize="16" FontWeight="Bold"
													   HorizontalAlignment="Center" VerticalAlignment="Center"
													   TextAlignment="Center" IsVisible="False" />

											<Image Name="ImgDiagram" Stretch="Uniform"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center">
												<Image.RenderTransform>
													<TransformGroup>
														<ScaleTransform />
														<TranslateTransform />
													</TransformGroup>
												</Image.RenderTransform>
											</Image>

											<StackPanel Name="PnlDiagramSwitch" Orientation="Vertical" Spacing="5"
														HorizontalAlignment="Left" VerticalAlignment="Bottom"
														Margin="15,0,0,60" IsVisible="False">
												<Button Name="BtnDiagram1" Width="40" Height="40" CornerRadius="15"
														Click="BtnDiagramSwitch_Click" Tag="0" Background="{x:Static local:Scheme.BrushBgPanel2}"
														ToolTip.Tip="Diagramm 1">
													<svg:Svg Path="/assets/icons/ic_one.svg" Width="20" Height="20" />
												</Button>
												<Button Name="BtnDiagram2" Width="40" Height="40" CornerRadius="15"
														Click="BtnDiagramSwitch_Click" Tag="1" Background="{x:Static local:Scheme.BrushBgPanel2}"
														ToolTip.Tip="Diagramm 2">
													<svg:Svg Path="/assets/icons/ic_two.svg" Width="20" Height="20" />
												</Button>
												<Button Name="BtnDiagram3" Width="40" Height="40" CornerRadius="15"
														Click="BtnDiagramSwitch_Click" Tag="2" Background="{x:Static local:Scheme.BrushBgPanel2}"
														ToolTip.Tip="Diagramm 3">
													<svg:Svg Path="/assets/icons/ic_three.svg" Width="20" Height="20" />
												</Button>
											</StackPanel>

											<Button Name="BtnResetDiagram"
													Background="{x:Static local:Scheme.BrushBgPanel2}"
													Width="40" Height="40"
													CornerRadius="5"
													ToolTip.Tip="Diagramm zurücksetzen"
													HorizontalAlignment="Left"
													VerticalAlignment="Bottom"
													Margin="15,10,10,10"
													Click="BtnResetDiagram_Click">
												<svg:Svg Path="/assets/icons/ic_restart.svg" Width="20" Height="20" />
											</Button>

											<TextBlock Text="Mausrad: Zoom | Drag: Bewegen"
													   Foreground="{x:Static local:Scheme.BrushBgPanel9}" FontSize="12"
													   HorizontalAlignment="Right" VerticalAlignment="Bottom"
													   Margin="10,10,15,10" />
										</Panel>

										<GridSplitter Name="UmlRelationalSplitter" IsVisible="False" Grid.Row="1"
													  Background="Transparent" ResizeDirection="Rows"
													  HorizontalAlignment="Stretch" Height="8" Cursor="SizeNorthSouth"
													  PointerEntered="GridSplitter_PointerEntered"
													  PointerExited="GridSplitter_PointerExited">
											<GridSplitter.Template>
												<ControlTemplate>
													<Grid Background="Transparent">
														<Border Name="HoverLine" Background="{x:Static local:Scheme.BrushTextTitle}" Height="2"
																VerticalAlignment="Center" Opacity="0" />
														<Border Name="Handle" Background="{x:Static local:Scheme.BrushTextNormal2}" Height="2" Width="30"
																CornerRadius="2" HorizontalAlignment="Center"
																VerticalAlignment="Center" />
													</Grid>
												</ControlTemplate>
											</GridSplitter.Template>
											<GridSplitter.Styles>
												<Style Selector="GridSplitter /template/ Border#HoverLine">
													<Setter Property="Transitions">
														<Transitions>
															<DoubleTransition Property="Opacity" Duration="0:0:0.15" />
														</Transitions>
													</Setter>
												</Style>
												<Style Selector="GridSplitter.hover-active /template/ Border#HoverLine">
													<Setter Property="Opacity" Value="1" />
												</Style>

												<Style Selector="GridSplitter /template/ Border#Handle">
													<Setter Property="Transitions">
														<Transitions>
															<DoubleTransition Property="Opacity" Duration="0:0:0.15" />
														</Transitions>
													</Setter>
												</Style>
												<Style Selector="GridSplitter.hover-active /template/ Border#Handle">
													<Setter Property="Opacity" Value="0" />
												</Style>

												<Style Selector="GridSplitter.dragging /template/ Border#HoverLine">
													<Setter Property="Transitions">
														<Transitions />
													</Setter>
													<Setter Property="Opacity" Value="1" />
												</Style>
												<Style Selector="GridSplitter.dragging /template/ Border#Handle">
													<Setter Property="Transitions">
														<Transitions />
													</Setter>
													<Setter Property="Opacity" Value="0" />
												</Style>
											</GridSplitter.Styles>
										</GridSplitter>

										<Border Name="UmlRelationalBorder" IsVisible="False" Grid.Row="2"
												Background="{x:Static local:Scheme.BrushBadgeDefault}" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" BorderThickness="0,1,0,0">
											<ScrollViewer MaxHeight="350">
												<StackPanel Name="PnlUmlRelationalModel" Margin="20" Spacing="10" />
											</ScrollViewer>
										</Border>
									</Grid>
								</Border>
							</TabItem>

							<TabItem Header="Materialien">
								<Border Background="{x:Static local:Scheme.BrushBgPanel}" CornerRadius="8" Margin="0" ClipToBounds="True">
									<ScrollViewer>
										<StackPanel Name="PnlMaterials" Spacing="10" Margin="20" />
									</ScrollViewer>
								</Border>
							</TabItem>

							<TabItem Header="Level Designer" Name="TabDesigner" IsVisible="False">
								<Border Background="{x:Static local:Scheme.BrushBgPanel}" CornerRadius="8" Padding="20" Margin="0" ClipToBounds="True">
									<Grid RowDefinitions="Auto, *">
										<Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto, Auto" Margin="0,0,0,15">

											<Button Grid.Column="0" Name="BtnDesignerExport" Background="{x:Static local:Scheme.BrushTextTitle}"
													Width="40" Height="40" CornerRadius="5"
													Click="BtnDesignerExport_Click" IsEnabled="False"
													ToolTip.Tip="Level Exportieren" Margin="0,0,10,0">
												<svg:Svg Path="/assets/icons/ic_export.svg" Width="20" Height="20" />
											</Button>

											<Button Grid.Column="1" Name="BtnDesignerPublish" Background="{x:Static local:Scheme.BrushGlobalBg}"
													Width="40" Height="40" CornerRadius="5"
													Click="BtnDesignerPublish_Click" IsEnabled="False"
													ToolTip.Tip="Level Veröffentlichen" Margin="0,0,10,0">
												<svg:Svg Path="/assets/icons/ic_publish.svg" Width="20" Height="20" />
											</Button>

											<Button Grid.Column="2" Name="BtnDesignerSave" Background="{x:Static local:Scheme.BrushBgPanel18}" Width="40"
													Height="40" CornerRadius="5"
													Click="BtnDesignerSave_Click" ToolTip.Tip="Entwurf Speichern">
												<svg:Svg Path="/assets/icons/ic_save.svg" Width="20" Height="20" />
											</Button>

											<CheckBox Grid.Column="3" Name="ChkDesignerAutoSave" Content="Auto-Save"
													  IsChecked="True"
													  Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0" />

											<TextBlock Grid.Column="5" Name="TxtDesignerStatus" Text="Bereit"
													   VerticalAlignment="Center" Foreground="Gray" Margin="10,0,0,0" />

											<Button Grid.Column="6" Name="BtnDesignerGuide" Background="{x:Static local:Scheme.BrushTextHighlight2}" Width="40"
													Height="40" CornerRadius="5"
													Click="BtnDesignerGuide_Click" ToolTip.Tip="Guide / Hilfe (GitHub)"
													Margin="10,0,0,0">
												<svg:Svg Path="/assets/icons/ic_guide.svg" Width="20" Height="20" />
											</Button>
										</Grid>

										<ScrollViewer Grid.Row="1">
											<StackPanel Spacing="15" Margin="0,0,20,0">
												<Grid ColumnDefinitions="*, 10, *">
													<StackPanel Grid.Column="0" Spacing="5">
														<TextBlock Text="Level Name" Foreground="Gray" />
														<TextBox Name="TxtDesignName" Background="{x:Static local:Scheme.BrushBadgeDefault}"
																 Foreground="White" BorderThickness="1" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" />
													</StackPanel>
													<StackPanel Grid.Column="2" Spacing="5">
														<TextBlock Text="Autor" Foreground="Gray" />
														<TextBox Name="TxtDesignAuthor" Background="{x:Static local:Scheme.BrushBadgeDefault}"
																 Foreground="White" BorderThickness="1" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" />
													</StackPanel>
												</Grid>

												<StackPanel Spacing="5">
													<TextBlock Text="Aufgabe" Foreground="Gray" />
													<TextBox Name="TxtDesignDesc" AcceptsReturn="True" TextWrapping="Wrap"
															 Height="150"
															 Background="{x:Static local:Scheme.BrushBadgeDefault}" Foreground="White" FontFamily="Consolas"
															 BorderThickness="1" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" />
												</StackPanel>

												<Separator Background="{x:Static local:Scheme.BrushBgPanel5}" Margin="0,15" />

												<StackPanel Spacing="5">
													<TextBlock Text="UML/Diagramme (PlantUML)" Foreground="Gray" />

													<Border Background="{x:Static local:Scheme.BrushTextNormal3}" CornerRadius="4" Padding="2">
														<Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto">
															<ScrollViewer Grid.Column="0"
																		  HorizontalScrollBarVisibility="Auto"
																		  VerticalScrollBarVisibility="Disabled"
																		  Margin="0,0,10,0">
																<StackPanel Name="PnlDesignerDiagramTabs"
																			Orientation="Horizontal" Spacing="2" />
															</ScrollViewer>

															<Button Grid.Column="1" Name="BtnDeleteDiagramTab" Width="30"
																	Height="30"
																	Background="Transparent"
																	Click="BtnDeleteDiagramTab_Click"
																	ToolTip.Tip="Aktuelles Diagramm löschen"
																	Margin="0,0,2,0" IsVisible="False">
																<svg:Svg Path="/assets/icons/ic_delete.svg" Width="16"
																		 Height="16" />
															</Button>

															<Button Grid.Column="2" Name="BtnWebUml" Width="30" Height="30"
																	Background="Transparent" Click="BtnWebUml_Click"
																	ToolTip.Tip="Online Editor öffnen" Margin="0,0,2,0">
																<svg:Svg Path="/assets/icons/ic_web.svg" Width="16"
																		 Height="16" />
															</Button>

															<Button Grid.Column="3" Name="BtnGenerateUml" Width="30"
																	Height="30"
																	Background="Transparent" Click="BtnGenerateUml_Click"
																	ToolTip.Tip="Vorschau generieren (Aktives Tab)"
																	Margin="0,0,5,0">
																<svg:Svg Path="/assets/icons/ic_generate.svg" Width="16"
																		 Height="16" />
															</Button>

															<Button Grid.Column="4" Name="BtnAddDiagramTab" Width="30"
																	Height="30"
																	Background="Transparent" Click="BtnAddDiagramTab_Click"
																	ToolTip.Tip="Neues Material-Diagramm hinzufügen">
																<svg:Svg Path="/assets/icons/ic_add.svg" Width="16"
																		 Height="16" />
															</Button>
														</Grid>
													</Border>

													<TextBox Name="TxtDesignPlantUml" AcceptsReturn="True"
															 TextWrapping="Wrap" Height="150"
															 Background="{x:Static local:Scheme.BrushBadgeDefault}" Foreground="{x:Static local:Scheme.BrushTextNormal6}"
															 FontFamily="Consolas"
															 BorderThickness="1" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" />
												</StackPanel>

												<StackPanel Spacing="5">
													<TextBlock Text="Materialien" Foreground="Gray" />
													<TextBox Name="TxtDesignMaterials" AcceptsReturn="True"
															 TextWrapping="Wrap" Height="150"
															 Background="{x:Static local:Scheme.BrushBadgeDefault}" Foreground="White" FontFamily="Consolas"
															 BorderThickness="1" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" />
												</StackPanel>

												<StackPanel Spacing="5" ZIndex="10">
													<TextBlock Name="TxtPrereqTitle"
															   Text="Voraussetzungen / Grundlagen (Suche auf Englisch)"
															   Foreground="Gray" />

													<Grid>
														<TextBox Name="TxtDesignPrereqInput"
																 Watermark="z.B. If statements..."
																 Background="{x:Static local:Scheme.BrushBadgeDefault}" Foreground="White"
																 BorderThickness="1" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" />

														<Border Name="PopupPrereqSuggestions" IsVisible="False"
																Background="{x:Static local:Scheme.BrushTextNormal3}" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" BorderThickness="1"
																CornerRadius="4" ClipToBounds="True"
																Margin="0,32,0,0" VerticalAlignment="Top" MaxHeight="175">
															<ListBox Name="LstPrereqSuggestions" Background="Transparent"
																	 Foreground="{x:Static local:Scheme.BrushTextNormal7}">
																<ListBox.Styles>
																	<Style Selector="ListBoxItem">
																		<Setter Property="Padding" Value="10,8" />
																		<Setter Property="Cursor" Value="Hand" />
																	</Style>
																</ListBox.Styles>
															</ListBox>
														</Border>
													</Grid>

													<StackPanel Name="PnlDesignPrereqsList" Spacing="2" Margin="0,5,0,0" />
												</StackPanel>

												<Separator Background="{x:Static local:Scheme.BrushBgPanel5}" Margin="0,15" />

												<StackPanel Name="PnlDesignStarter" Spacing="5">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="Starter Code" Foreground="Gray"
																   VerticalAlignment="Center" ToolTip.Tip="Der Code den der Nutzer sofort bekommt" />
														<Button Grid.Column="1" Name="BtnEditStarter" Width="30"
																Height="30"
																Background="Transparent" Click="BtnEditStarter_Click"
																ToolTip.Tip="Im Editor bearbeiten">
															<svg:Svg Path="/assets/icons/ic_move.svg" Width="16"
																	 Height="16" />
														</Button>
													</Grid>
													<TextBox Name="TxtDesignStarter" AcceptsReturn="True"
															 TextWrapping="Wrap" Height="150"
															 Background="{x:Static local:Scheme.BrushBadgeDefault}" Foreground="{x:Static local:Scheme.BrushTextNormal6}"
															 FontFamily="Consolas"
															 BorderThickness="1" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" />
												</StackPanel>

												<StackPanel Name="PnlDesignTesting" Spacing="5">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="Musterlösung / Test-Code"
																   Foreground="Gray" VerticalAlignment="Center"
																   ToolTip.Tip="Wird verwendet, um zu Prüfen ob das Level überhaupt lösbar ist. Dies wird nicht exportiert!" />
														<Button Grid.Column="1" Name="BtnEditTesting" Width="30"
																Height="30"
																Background="Transparent" Click="BtnEditTesting_Click"
																ToolTip.Tip="Im Editor testen">
															<svg:Svg Path="/assets/icons/ic_move.svg" Width="16"
																	 Height="16" />
														</Button>
													</Grid>
													<TextBox Name="TxtDesignTesting" AcceptsReturn="True"
															 TextWrapping="Wrap" Height="150"
															 Background="{x:Static local:Scheme.BrushBadgeDefault}" Foreground="{x:Static local:Scheme.BrushTextNormal6}"
															 FontFamily="Consolas"
															 BorderThickness="1" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" />
												</StackPanel>

												<StackPanel Name="PnlDesignValidation" Spacing="5">
													<Grid ColumnDefinitions="*, Auto, Auto">
														<TextBlock Text="Validierungs-Code (Roslyn Test Logik)"
																   Foreground="Gray" VerticalAlignment="Center"
																   ToolTip.Tip="Hier wird C#-Rosyln-Validierungscode eingefügt, welcher auf Systemebene prüft, ob ein anderer C#-Code spezifische Bedingungen erfüllt" />
														<Button Grid.Column="1" Name="BtnResetValidation" Width="30"
																Height="30"
																Background="Transparent" Click="BtnResetValidation_Click"
																Margin="0,0,5,0" ToolTip.Tip="Validierung zurücksetzen">
															<svg:Svg Path="/assets/icons/ic_restart.svg" Width="16"
																	 Height="16" />
														</Button>
														<Button Grid.Column="2" Name="BtnEditValidation" Width="30"
																Height="30"
																Background="Transparent" Click="BtnEditValidation_Click"
																ToolTip.Tip="Im Editor bearbeiten">
															<svg:Svg Path="/assets/icons/ic_move.svg" Width="16"
																	 Height="16" />
														</Button>
													</Grid>
													<TextBox Name="TxtDesignValidation" AcceptsReturn="True"
															 TextWrapping="Wrap" Height="150"
															 Background="{x:Static local:Scheme.BrushBadgeDefault}" Foreground="{x:Static local:Scheme.BrushTextNormal6}"
															 FontFamily="Consolas"
															 BorderThickness="1" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" />
												</StackPanel>

												<StackPanel Name="PnlDesignSqlSetup" Spacing="5" IsVisible="False">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="Setup Script (CREATE TABLE / INSERT)"
																   Foreground="Gray" VerticalAlignment="Center"
																   ToolTip.Tip="Dies wird immer als erstes ausgeführt und ist für die Initailisierung deiner Datenbank gedacht"/>
														<Button Grid.Column="1" Name="BtnEditSqlSetup" Width="30"
																Height="30"
																Background="Transparent" Click="BtnEditSqlSetup_Click"
																ToolTip.Tip="Im Editor bearbeiten">
															<svg:Svg Path="/assets/icons/ic_move.svg" Width="16"
																	 Height="16" />
														</Button>
													</Grid>
													<TextBox Name="TxtDesignSqlSetup" AcceptsReturn="True"
															 TextWrapping="Wrap" Height="150"
															 Background="{x:Static local:Scheme.BrushBadgeDefault}" Foreground="{x:Static local:Scheme.BrushTextNormal6}"
															 FontFamily="Consolas"
															 BorderThickness="1" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" />
												</StackPanel>

												<StackPanel Name="PnlDesignSqlMode" Spacing="5" IsVisible="False">
													<TextBlock Text="Validierungs-Modus" Foreground="Gray"
															   VerticalAlignment="Center" ToolTip.Tip="Dies entscheidet, ob du die 'SELECT'-Anweisung angibst, die die zu überprüfene Tabelle erzeugt oder der Nutzer selbst" />
													<ComboBox Name="CmbSqlValidationMode" Background="{x:Static local:Scheme.BrushBadgeDefault}"
															  Foreground="White" SelectedIndex="0"
															  HorizontalAlignment="Stretch">
														<ComboBoxItem Content="SELECT Abfrage (Standard)" />
														<ComboBoxItem Content="DML (UPDATE / INSERT / DELETE)" />
													</ComboBox>
												</StackPanel>

												<StackPanel Name="PnlDesignExpectedTable" Spacing="5" IsVisible="False">
													<TextBlock Text="Erwartetes Ergebnis (Tabelle)" Foreground="Gray"
															   VerticalAlignment="Center" ToolTip.Tip="Dies ist die Tabelle, die durch die entgültige 'SELECT'-Anweisung enstehen soll. Tipp: Nutze ' für strenge erwartete Spaltennamen" />
													<Border Background="{x:Static local:Scheme.BrushBadgeDefault}" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" BorderThickness="1"
															CornerRadius="4" Padding="5">
														<ScrollViewer HorizontalScrollBarVisibility="Auto"
																	  VerticalScrollBarVisibility="Auto" MaxHeight="250">
															<Grid Name="GridExpectedTable" Margin="5" />
														</ScrollViewer>
													</Border>
												</StackPanel>

												<StackPanel Name="PnlDesignSqlSample" Spacing="5" IsVisible="False">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="Musterlösung (Lösung des Levels zur Validierung)"
																   Foreground="Gray" VerticalAlignment="Center" ToolTip.Tip="Wir nutzen diese Anweisung(en), um zu überprüfen ob das Level überhaupt lösbar ist. Dies wird nicht exportiert!" />
														<Button Grid.Column="1" Name="BtnEditSqlSample" Width="30"
																Height="30"
																Background="Transparent" Click="BtnEditSqlSample_Click"
																ToolTip.Tip="Im Editor bearbeiten">
															<svg:Svg Path="/assets/icons/ic_move.svg" Width="16"
																	 Height="16" />
														</Button>
													</Grid>
													<TextBox Name="TxtDesignSqlSample" AcceptsReturn="True"
															 TextWrapping="Wrap" Height="150"
															 Background="{x:Static local:Scheme.BrushBadgeDefault}" Foreground="{x:Static local:Scheme.BrushTextNormal6}"
															 FontFamily="Consolas"
															 BorderThickness="1" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" />
												</StackPanel>

												<StackPanel Name="PnlDesignSqlVerify" Spacing="5" IsVisible="False">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="Verifizierungs-Abfrage (Nur für DML nötig)"
																   Foreground="Gray" VerticalAlignment="Center" ToolTip.Tip="Bei DML-Level müssen wir selbst die erwartete Tabelle erzeugen, nur ist dies statisch, d.h. der Nutzer muss die Tabellen selbst abändern, um die erwartete Tabelle hierdurch anzeigen zu können" />
														<Button Grid.Column="1" Name="BtnEditSqlVerify" Width="30"
																Height="30"
																Background="Transparent" Click="BtnEditSqlVerify_Click"
																ToolTip.Tip="Im Editor bearbeiten">
															<svg:Svg Path="/assets/icons/ic_move.svg" Width="16"
																	 Height="16" />
														</Button>
													</Grid>
													<TextBox Name="TxtDesignSqlVerify" AcceptsReturn="True"
															 TextWrapping="Wrap" Height="150"
															 Background="{x:Static local:Scheme.BrushBadgeDefault}" Foreground="{x:Static local:Scheme.BrushTextNormal6}"
															 FontFamily="Consolas"
															 BorderThickness="1" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" />
												</StackPanel>
											</StackPanel>
										</ScrollViewer>
									</Grid>
								</Border>
							</TabItem>

							<TabItem Header="Vim Hilfe" Name="TabVim" IsVisible="False">
								<Border Background="{x:Static local:Scheme.BrushBgPanel}" CornerRadius="8" Padding="0" Margin="0" ClipToBounds="True">
									<Grid RowDefinitions="*, Auto">

										<ScrollViewer Name="PnlVimCheatSheet" Grid.Row="0">
											<StackPanel Spacing="10" Margin="20">
												<Grid ColumnDefinitions="Auto, *, Auto">
													<ContentControl Name="CcVimCheatSheetToggle" Grid.Column="0" VerticalAlignment="Center" />

													<Button Grid.Column="2" Name="BtnStartTutorial"
															Content="Starte Vim Tutorial"
															Background="{x:Static local:Scheme.BrushTextHighlight2}" Foreground="White" CornerRadius="4"
															Padding="10,5" FontWeight="Bold"
															Click="BtnStartTutorial_Click" />
												</Grid>
												<Grid ColumnDefinitions="*, 20, *" RowDefinitions="Auto" Margin="0,20,0,0">
													<StackPanel Grid.Column="0" Name="VimCol1" Spacing="20" />
													<StackPanel Grid.Column="2" Name="VimCol2" Spacing="20" />
												</Grid>
											</StackPanel>
										</ScrollViewer>

										<Panel Name="PnlVimTutorial" Grid.Row="0" IsVisible="False" Margin="20">
											<Grid RowDefinitions="Auto, *, Auto">
												<StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,15">
													<Grid ColumnDefinitions="*, Auto">
														<TextBlock Text="Vim Tutorial" FontSize="20" FontWeight="Bold"
																   Foreground="{x:Static local:Scheme.BrushTextTitle}" VerticalAlignment="Center" />
														<Button Grid.Column="1" Name="BtnExitTutorial"
																Content="Tutorial Beenden"
																Background="{x:Static local:Scheme.BrushDiffHard}" Foreground="White" CornerRadius="4"
																Padding="10,5" FontWeight="Bold"
																Click="BtnExitTutorial_Click" />
													</Grid>
													<SelectableTextBlock Name="TxtTutorialTask" FontSize="16"
																		 Foreground="White" TextWrapping="Wrap"
																		 VerticalAlignment="Center" />
												</StackPanel>
												<Border Grid.Row="1" Classes="editor-focus-border" CornerRadius="8" ClipToBounds="True"
														BorderThickness="1" Background="{x:Static local:Scheme.BrushBadgeDefault}">
													<Grid RowDefinitions="*, Auto">
														<ae:TextEditor Name="TutorialEditor"
																	   Grid.Row="0"
																	   HorizontalScrollBarVisibility="Auto"
																	   VerticalScrollBarVisibility="Auto"
																	   ShowLineNumbers="True"
																	   Padding="0,0,18,0" />
														<Border Grid.Row="1" Background="{x:Static local:Scheme.BrushTextHighlight2}"
																Name="TutorialVimStatusBorder" Padding="5,2">
															<TextBlock Name="TutorialVimStatusBar" Text="-- NORMAL --"
																	   FontFamily="Consolas" FontSize="12"
																	   Foreground="White" FontWeight="Bold" />
														</Border>
													</Grid>
												</Border>
												<Border Grid.Row="2" Name="PnlTutorialStats" IsVisible="False"
														Background="{x:Static local:Scheme.BrushBgPanel13}" CornerRadius="8" Padding="15"
														Margin="0,15,0,0">
													<StackPanel Name="PnlTutorialStatsContent" HorizontalAlignment="Center"
																Spacing="10" />
												</Border>
											</Grid>
										</Panel>

										<TextBlock Grid.Row="1" Text="Hinweis: Dies ist eine vereinfachte Simulation."
												   Foreground="{x:Static local:Scheme.BrushBgPanel9}" FontSize="12" Margin="0,20,0,20"
												   HorizontalAlignment="Center" />
									</Grid>
								</Border>
							</TabItem>

						</TabControl>

						<Border Name="PnlTabTip" IsVisible="False" VerticalAlignment="Top" HorizontalAlignment="Left"
								Margin="0,-25,0,0" Background="{x:Static local:Scheme.BrushTextTitle}" CornerRadius="4" Padding="10,5"
								BorderBrush="{x:Static local:Scheme.BrushBadgeDefault}" BorderThickness="1" ZIndex="100"
								PointerEntered="PnlTabTip_PointerEntered" PointerExited="PnlTabTip_PointerExited">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock Text="Tipp: Nutze F1 - F4 zum Wechseln der Tabs" Foreground="White"
										   FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
								<Button Name="BtnCloseTip" Background="Transparent" Foreground="White"
										Padding="5,0" Margin="0" VerticalAlignment="Center" FontWeight="Bold" Cursor="Hand">
									<svg:Svg Path="/assets/icons/ic_close.svg" Width="16" Height="16" />
								</Button>
							</StackPanel>
						</Border>

						<Border Name="PnlRelationalTip" IsVisible="False" VerticalAlignment="Bottom"
								HorizontalAlignment="Left"
								Margin="50,0,0,30" Background="{x:Static local:Scheme.BrushTextTitle}" CornerRadius="4" Padding="10,5"
								BorderBrush="{x:Static local:Scheme.BrushBadgeDefault}" BorderThickness="1" ZIndex="100"
								PointerEntered="PnlRelationalTip_PointerEntered" PointerExited="PnlRelationalTip_PointerExited">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<TextBlock
									Text="Tipp: Nutze '(' für Spalten, ',' für nächste Spalte, ')' für neue Tabelle, sowie '_PK' oder '_FK'."
									Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"
									TextWrapping="Wrap" MaxWidth="400" />
								<Button Name="BtnCloseRelationalTip" Background="Transparent" Foreground="White"
										Padding="5,0" Margin="0" VerticalAlignment="Center" FontWeight="Bold" Cursor="Hand">
									<svg:Svg Path="/assets/icons/ic_close.svg" Width="16" Height="16" />
								</Button>
							</StackPanel>
						</Border>
					</Panel>

					<GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" Width="8"
								  Cursor="SizeWestEast"
								  PointerEntered="GridSplitter_PointerEntered" PointerExited="GridSplitter_PointerExited">
						<GridSplitter.Template>
							<ControlTemplate>
								<Grid Background="Transparent">
									<Border Name="HoverLine" Background="{x:Static local:Scheme.BrushTextTitle}" Width="2" HorizontalAlignment="Center"
											Opacity="0" />
									<Border Name="Handle" Background="{x:Static local:Scheme.BrushTextNormal2}" Width="2" Height="30" CornerRadius="2"
											HorizontalAlignment="Center" VerticalAlignment="Center" />
								</Grid>
							</ControlTemplate>
						</GridSplitter.Template>
						<GridSplitter.Styles>
							<Style Selector="GridSplitter /template/ Border#HoverLine">
								<Setter Property="Transitions">
									<Transitions>
										<DoubleTransition Property="Opacity" Duration="0:0:0.15" />
									</Transitions>
								</Setter>
							</Style>
							<Style Selector="GridSplitter.hover-active /template/ Border#HoverLine">
								<Setter Property="Opacity" Value="1" />
							</Style>

							<Style Selector="GridSplitter /template/ Border#Handle">
								<Setter Property="Transitions">
									<Transitions>
										<DoubleTransition Property="Opacity" Duration="0:0:0.15" />
									</Transitions>
								</Setter>
							</Style>
							<Style Selector="GridSplitter.hover-active /template/ Border#Handle">
								<Setter Property="Opacity" Value="0" />
							</Style>

							<Style Selector="GridSplitter.dragging /template/ Border#HoverLine">
								<Setter Property="Transitions">
									<Transitions />
								</Setter>
								<Setter Property="Opacity" Value="1" />
							</Style>
							<Style Selector="GridSplitter.dragging /template/ Border#Handle">
								<Setter Property="Transitions">
									<Transitions />
								</Setter>
								<Setter Property="Opacity" Value="0" />
							</Style>
						</GridSplitter.Styles>
					</GridSplitter>

					<Grid Grid.Column="2" RowDefinitions="Auto, *, 8, 180" Margin="0,10,10,10">

						<Border Name="PnlSpoilerTip" IsVisible="False"
								Grid.RowSpan="4"
								VerticalAlignment="Top" HorizontalAlignment="Center"
								Margin="-100,-50,100,20"
								Background="{x:Static local:Scheme.BrushTextNormal4}" CornerRadius="4" Padding="12,8"
								BorderBrush="{x:Static local:Scheme.BrushDopamineEnducingGold}" BorderThickness="1" ZIndex="100">
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock
									Text="Tipp: Die Level-Namen können Lösungsansätze verraten.&#x0a;Möchtest du diese verbergen? (Zurücksetzbar)"
									Foreground="White" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
								<Button Name="BtnEnableSpoilerMode" Content="Ja" Background="{x:Static local:Scheme.BrushTextTitle}" Foreground="White"
										Padding="10,5" Margin="5,0,0,0" CornerRadius="4" VerticalAlignment="Center"
										FontWeight="Bold" Cursor="Hand"
										Click="BtnEnableSpoilerMode_Click" />
								<Button Name="BtnCloseSpoilerTip" Background="Transparent" Foreground="White"
										Padding="5,0" Margin="0" VerticalAlignment="Center" FontWeight="Bold" Cursor="Hand"
										Click="BtnCloseSpoilerTip_Click">
									<svg:Svg Path="/assets/icons/ic_close.svg" Width="16" Height="16" />
								</Button>
							</StackPanel>
						</Border>

						<Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
							<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" MinHeight="36">

								<Panel>
									<Button Name="BtnInbox"
											Background="{x:Static local:Scheme.BrushBgPanel18}" Width="40"
											CornerRadius="5" Click="BtnInbox_Click" ToolTip.Tip="Posteingang">
										<svg:Svg Path="/assets/icons/ic_inbox.svg" Width="20" Height="20" />
									</Button>

									<Border Name="BadgeInbox" IsVisible="False" Background="{x:Static local:Scheme.BrushTextHighlight2}" Width="10"
											Height="10" CornerRadius="5"
											HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
											BorderBrush="{x:Static local:Scheme.BrushBadgeDefault}" BorderThickness="1" IsHitTestVisible="False" />
								</Panel>

								<Panel>
									<Button Name="BtnSettings"
											Background="{x:Static local:Scheme.BrushBgPanel18}" Width="40"
											CornerRadius="5" Click="BtnSettings_Click" ToolTip.Tip="Einstellungen">
										<svg:Svg Path="/assets/icons/ic_settings.svg" Width="20" Height="20" />
									</Button>

									<Border Name="BadgeSettings" IsVisible="False" Background="{x:Static local:Scheme.BrushDiffHard}" Width="10"
											Height="10" CornerRadius="5"
											HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
											BorderBrush="{x:Static local:Scheme.BrushBadgeDefault}" BorderThickness="1" IsHitTestVisible="False" />
								</Panel>

								<Button Name="BtnReset" Background="{x:Static local:Scheme.BrushDiffHard}" Width="40"
										CornerRadius="5" Click="BtnReset_Click" ToolTip.Tip="Code zurücksetzen">
									<svg:Svg Path="/assets/icons/ic_restart.svg" Width="20" Height="20" />
								</Button>

								<Button Name="BtnSave" Background="{x:Static local:Scheme.BrushBgPanel18}" Width="50"
										CornerRadius="5" Click="BtnSave_Click" ToolTip.Tip="Code speichern (Ctrl + S)">
									<svg:Svg Path="/assets/icons/ic_save.svg" Width="20" Height="20" />
								</Button>

								<Button Name="BtnRun" Background="{x:Static local:Scheme.BrushTextTitle}" Foreground="White"
										FontWeight="Bold"
										Padding="15,8" CornerRadius="5" Click="BtnRun_Click" Width="135"
										HorizontalContentAlignment="Center">
									<StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" Margin="-8,0,0,0">
										<svg:Svg Name="IconRun" Path="/assets/icons/ic_run.svg" Width="18" Height="18" VerticalAlignment="Center" />
										<TextBlock Name="TxtRun" Text="AUSFÜHREN" VerticalAlignment="Center" />
									</StackPanel>
								</Button>

							</StackPanel>
						</Grid>

						<Panel Grid.Row="1" Name="PnlCsharpEditor">
							<Border Classes="editor-focus-border" CornerRadius="10" ClipToBounds="True" Background="{x:Static local:Scheme.BrushBadgeDefault}" BorderThickness="1">
								<Grid RowDefinitions="*, Auto">
									<ae:TextEditor Name="CodeEditor"
												   Grid.Row="0"
												   FontFamily="Consolas, Menlo, Monaco, DejaVu Sans Mono, Roboto Mono, Courier New, monospace"
												   FontSize="16"
												   ShowLineNumbers="True"
												   Background="Transparent"
												   Foreground="{x:Static local:Scheme.BrushTextNormal6}"
												   Padding="0,0,18,0"
												   HorizontalScrollBarVisibility="Auto"
												   VerticalScrollBarVisibility="Auto" />

									<Border Grid.Row="1" Background="{x:Static local:Scheme.BrushTextHighlight2}" Name="VimStatusBorder" IsVisible="False"
											Padding="5,2">
										<TextBlock Name="VimStatusBar"
												   Text="-- NORMAL --"
												   FontFamily="Consolas"
												   FontSize="12"
												   Foreground="White"
												   FontWeight="Bold" />
									</Border>
								</Grid>
							</Border>
						</Panel>

						<GridSplitter Grid.Row="2" Background="Transparent" ResizeDirection="Rows"
									  HorizontalAlignment="Stretch" Height="8" Cursor="SizeNorthSouth"
									  PointerEntered="GridSplitter_PointerEntered"
									  PointerExited="GridSplitter_PointerExited">
							<GridSplitter.Template>
								<ControlTemplate>
									<Grid Background="Transparent">
										<Border Name="HoverLine" Background="{x:Static local:Scheme.BrushTextTitle}" Height="2" VerticalAlignment="Center"
												Opacity="0" />
										<Border Name="Handle" Background="{x:Static local:Scheme.BrushTextNormal2}" Height="2" Width="30" CornerRadius="2"
												HorizontalAlignment="Center" VerticalAlignment="Center" />
									</Grid>
								</ControlTemplate>
							</GridSplitter.Template>
							<GridSplitter.Styles>
								<Style Selector="GridSplitter /template/ Border#HoverLine">
									<Setter Property="Transitions">
										<Transitions>
											<DoubleTransition Property="Opacity" Duration="0:0:0.15" />
										</Transitions>
									</Setter>
								</Style>
								<Style Selector="GridSplitter.hover-active /template/ Border#HoverLine">
									<Setter Property="Opacity" Value="1" />
								</Style>

								<Style Selector="GridSplitter /template/ Border#Handle">
									<Setter Property="Transitions">
										<Transitions>
											<DoubleTransition Property="Opacity" Duration="0:0:0.15" />
										</Transitions>
									</Setter>
								</Style>
								<Style Selector="GridSplitter.hover-active /template/ Border#Handle">
									<Setter Property="Opacity" Value="0" />
								</Style>

								<Style Selector="GridSplitter.dragging /template/ Border#HoverLine">
									<Setter Property="Transitions">
										<Transitions />
									</Setter>
									<Setter Property="Opacity" Value="1" />
								</Style>
								<Style Selector="GridSplitter.dragging /template/ Border#Handle">
									<Setter Property="Transitions">
										<Transitions />
									</Setter>
									<Setter Property="Opacity" Value="0" />
								</Style>
							</GridSplitter.Styles>
						</GridSplitter>

						<Panel Grid.Row="3">
							<Border Name="PnlCsharpConsole" CornerRadius="10" ClipToBounds="True" Background="{x:Static local:Scheme.BrushConsoleBg}" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" BorderThickness="1">
								<ae:TextEditor Name="ConsoleEditor"
											   FontFamily="Consolas, Menlo, Monaco, DejaVu Sans Mono, Roboto Mono, Courier New, monospace"
											   FontSize="13"
											   Padding="15"
											   IsReadOnly="True"
											   WordWrap="True"
											   ShowLineNumbers="False"
											   Background="Transparent"
											   Foreground="{x:Static local:Scheme.BrushTextNormal}"
											   HorizontalScrollBarVisibility="Disabled"
											   VerticalScrollBarVisibility="Auto" />
							</Border>

							<Border Name="PnlSqlQueryEditor" Classes="editor-focus-border" IsVisible="False" CornerRadius="10" ClipToBounds="True"
									Background="{x:Static local:Scheme.BrushBadgeDefault}" BorderThickness="1">
								<Grid RowDefinitions="Auto, *, Auto">
									<TextBlock Text="SQL QUERY EDITOR" FontSize="10" Foreground="Gray" Margin="10,5"
											   FontWeight="Bold" />
									<ae:TextEditor Name="SqlQueryEditor"
												   Grid.Row="1"
												   FontFamily="Consolas, Menlo, Monaco, DejaVu Sans Mono, Roboto Mono, Courier New, monospace"
												   FontSize="16"
												   ShowLineNumbers="True"
												   Background="Transparent"
												   Foreground="{x:Static local:Scheme.BrushTextNormal6}"
												   Padding="0,0,18,0"
												   HorizontalScrollBarVisibility="Auto"
												   VerticalScrollBarVisibility="Auto" />

									<Border Grid.Row="2" Background="{x:Static local:Scheme.BrushTextHighlight2}" Name="SqlVimStatusBorder" IsVisible="False"
											Padding="5,2">
										<TextBlock Name="SqlVimStatusBar"
												   Text="-- NORMAL --"
												   FontFamily="Consolas"
												   FontSize="12"
												   Foreground="White"
												   FontWeight="Bold" />
									</Border>
								</Grid>
							</Border>
						</Panel>

						<Border Name="PnlSqlOutputContainer" Grid.Row="1" IsVisible="False" CornerRadius="10"
								ClipToBounds="True" Background="{x:Static local:Scheme.BrushConsoleBg}" BorderBrush="{x:Static local:Scheme.BrushBgPanel5}" BorderThickness="1">
							<ScrollViewer Name="SqlOutputScroller">
								<StackPanel Name="PnlSqlOutput" Spacing="10" Margin="10" />
							</ScrollViewer>
						</Border>
					</Grid>
				</Grid>
			</Grid>

			<Canvas Name="DragGhostCanvas" IsHitTestVisible="False" ZIndex="1000" />
			<Canvas Name="DropIndicatorsCanvas" IsHitTestVisible="False" ZIndex="999">
				<Panel Width="{Binding $parent[Canvas].Bounds.Width}" Height="{Binding $parent[Canvas].Bounds.Height}">
					<Border Name="DropPreviewOverlay"
					        Background="{x:Static local:Scheme.BrushTabDockHighlight2}"
					        BorderBrush="{x:Static local:Scheme.BrushTextHighlight}"
					        BorderThickness="2"
					        CornerRadius="8"
					        Opacity="0"
					        HorizontalAlignment="Stretch"
					        VerticalAlignment="Stretch">
						<Border.Transitions>
							<Transitions>
								<ThicknessTransition Property="Margin" Duration="0:0:0.15" Easing="QuadraticEaseOut" />
								<DoubleTransition Property="Opacity" Duration="0:0:0.1" />
							</Transitions>
						</Border.Transitions>
					</Border>
				</Panel>

				<Border Name="TabReorderIndicator" Background="{x:Static local:Scheme.BrushTextHighlight}" Width="2" CornerRadius="1" Opacity="0">
					<Border.Transitions>
						<Transitions>
							<DoubleTransition Property="Canvas.Left" Duration="0:0:0.1" Easing="QuadraticEaseOut" />
							<DoubleTransition Property="Canvas.Top" Duration="0:0:0.1" Easing="QuadraticEaseOut" />
							<DoubleTransition Property="Height" Duration="0:0:0.1" Easing="QuadraticEaseOut" />
							<DoubleTransition Property="Opacity" Duration="0:0:0.1" />
						</Transitions>
					</Border.Transitions>
				</Border>
			</Canvas>
		</Grid>
	</LayoutTransformControl>
</Window>